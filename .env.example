# ============================
# Prism Fusion Site 环境变量
# 复制为 .env 后按需修改
# ============================

# ---------- 应用端口 ----------
GATEWAY_PORT=3280

# ---------- 数据库（主应用）----------
DB_HOST=
DB_PORT=3306
DB_NAME=prism_fusion_site
DB_USER=root
DB_PASSWORD=

# ============================================================
# Casdoor Authentication
# CLIENT_ID/CLIENT_SECRET 为预定义值
# 启动时自动同步到 Casdoor 应用（若 Casdoor 中的值不同则推送覆盖）
# ============================================================
CASDOOR_ENDPOINT=http://localhost:5203
CASDOOR_CLIENT_ID=<predefined-client-id>
CASDOOR_CLIENT_SECRET=<predefined-client-secret>
CASDOOR_ORG=prism-fusion
CASDOOR_APP=app-prism-fusion
# 外部 Casdoor 地址（浏览器跳转用，留空=与 ENDPOINT 相同）
CASDOOR_EXTERNAL_ENDPOINT=http://localhost:5203
CASDOOR_ADMIN_PASSWORD=
CASDOOR_APP_ADMIN_PASSWORD=
# QQ 邮箱 SMTP（Email Provider 自动配置，留空则跳过）
CASDOOR_QQ_MAIL_SMTP_ACCOUNT=
CASDOOR_QQ_MAIL_SMTP_SECRET=
# 外部服务 OIDC 回调地址（逗号分隔，bootstrap 时自动注册到 Casdoor 应用）
# 例如：https://storage.whitestone.top/rustfs/admin/v3/oidc/callback/default
EXTERNAL_OIDC_REDIRECT_URIS=

# ============================================================
# Casdoor Database (MySQL)
# 密码必须与 casdoor/casdoor_conf/app.conf 中的 dataSourceName 一致
# ============================================================
CASDOOR_DB_PASSWORD=casdoor_fusion_123
CASDOOR_DB_PORT=3301

# ============================================================
# Casdoor Nginx（预签名鉴权代理）
# ============================================================
CASDOOR_NGINX_PORT=5203
CASDOOR_NGINX_SERVER_NAME=localhost
STORAGE_PRESIGN_UPSTREAM=http://rclone-nginx:5001

# ============================================================
# S3-compatible Storage — 头像、文件存储 (Rclone)
# ============================================================
# S3 API 地址（需 prism-fusion 可达；Docker 内部自动使用 rclone-nginx:5001）
S3_ENDPOINT=http://localhost:5208
# S3 Access Key
S3_ACCESS_KEY=                           # S3 API Access Key（务必修改）
# S3 Secret Key
S3_SECRET_KEY=                           # S3 API Secret Key（务必修改）
# 外部可访问 URL（拼头像公开下载地址）
S3_PUBLIC_URL=http://localhost:5208

# ============================================================
# Rclone Nginx（S3 代理 + 预签名）
# ============================================================
RCLONE_NGINX_PORT=5208
RCLONE_NGINX_SERVER_NAME=localhost
# 浏览器可达的 S3 地址（用于生成预签名 URL）
S3_HOST=localhost:5208
S3_SCHEME=http

# ============================================================
# Rclone Admin Web GUI（按需启动: docker compose --profile admin up -d）
# 访问: http://127.0.0.1:${RCLONE_ADMIN_PORT}
# ============================================================
RCLONE_ADMIN_USER=                      # Web GUI 登录用户名（务必修改）
RCLONE_ADMIN_PASS=                      # Web GUI 登录密码（务必使用强密码）
RCLONE_ADMIN_PORT=5209