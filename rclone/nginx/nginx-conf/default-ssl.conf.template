# ---- njs 模块：预签名 URL 生成 + 代理鉴权签名 ----
js_import presign from /etc/nginx/njs/presign.js;
js_set $s3_proxy_auth presign.proxyAuth;

# ---- CORS 源白名单 ----
map $http_origin $cors_origin {
    default                                        '';
    '~^https?://localhost(:[0-9]+)?$'             $http_origin;
    '~^https?://127\.0\.0\.1(:[0-9]+)?$'         $http_origin;
    '~^https://[a-zA-Z0-9-]+\.whitestone\.top$'  $http_origin;
}

# ---- 公网写操作拦截：仅允许 presigned URL 上传，禁止直接 AK/SK ----
map "$request_method:$http_authorization" $block_s3_direct_write {
    "~^(GET|HEAD|OPTIONS):"  0;
    "~:$"                    0;
    default                  1;
}

# ==================================================================
# SSL server (公网，经 frpc 隧道到达)
# 策略：仅暴露已知 bucket、上传必须通过 presigned URL
# ==================================================================
server {
    listen 5000 ssl proxy_protocol;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/nginx/ssl/fullchain.cer;
    ssl_certificate_key /etc/nginx/ssl/whitestone.top.key;

    ssl_session_timeout 1d;
    ssl_session_cache shared:MozSSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;

    absolute_redirect off;
    client_max_body_size 5m;

    resolver 127.0.0.11 valid=30s ipv6=off;

    set $s3_access_key '${S3_ACCESS_KEY}';
    set $s3_secret_key '${S3_SECRET_KEY}';
    set $s3_proxy_date '';

    # ---- Bucket: user-avatar（公开读，presign-only 写）----
    location ~ ^/user-avatar/ {
        if ($block_s3_direct_write) {
            return 403;
        }

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, PUT, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Amz-Date, X-Amz-Content-Sha256, X-Amz-Security-Token' always;
            add_header 'Access-Control-Max-Age' 3600 always;
            return 204;
        }

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;

        add_header 'Access-Control-Allow-Origin' $cors_origin always;
        add_header 'Access-Control-Allow-Methods' 'GET, PUT, OPTIONS' always;
        add_header 'Access-Control-Expose-Headers' 'ETag, x-amz-request-id' always;

        proxy_set_header Authorization $s3_proxy_auth;
        proxy_set_header x-amz-date $s3_proxy_date;
        proxy_set_header x-amz-content-sha256 "UNSIGNED-PAYLOAD";

        proxy_pass http://rclone-avatar:9000$uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    # 其他路径一律 403
    location / {
        return 403;
    }
}

# ==================================================================
# Plain server (内网，Docker 网络 + localhost 可达)
# 提供：presign 端点 + S3 全功能代理
# ==================================================================
server {
    listen 5001;
    server_name ${NGINX_SERVER_NAME};

    absolute_redirect off;
    client_max_body_size 10m;

    resolver 127.0.0.11 valid=30s ipv6=off;

    set $s3_access_key '${S3_ACCESS_KEY}';
    set $s3_secret_key '${S3_SECRET_KEY}';
    set $s3_proxy_date '';

    # 头像预签名上传 URL（仅内网可达）
    location = /presign {
        set $s3_host '${S3_HOST}';
        set $s3_scheme '${S3_SCHEME}';
        js_content presign.handle;
    }

    # Bucket: user-avatar — 全功能代理到 rclone
    location ~ ^/user-avatar/ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, PUT, POST, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Amz-Date, X-Amz-Content-Sha256, X-Amz-Security-Token' always;
            add_header 'Access-Control-Max-Age' 3600 always;
            return 204;
        }

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;

        add_header 'Access-Control-Allow-Origin' $cors_origin always;
        add_header 'Access-Control-Allow-Methods' 'GET, PUT, POST, DELETE, OPTIONS' always;
        add_header 'Access-Control-Expose-Headers' 'ETag, x-amz-request-id' always;

        proxy_set_header Authorization $s3_proxy_auth;
        proxy_set_header x-amz-date $s3_proxy_date;
        proxy_set_header x-amz-content-sha256 "UNSIGNED-PAYLOAD";

        proxy_pass http://rclone-avatar:9000$uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # 其他 S3 操作（MakeBucket / ListBuckets 等）
    location / {
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;

        proxy_set_header Authorization $s3_proxy_auth;
        proxy_set_header x-amz-date $s3_proxy_date;
        proxy_set_header x-amz-content-sha256 "UNSIGNED-PAYLOAD";

        proxy_pass http://rclone-avatar:9000$uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }
}
